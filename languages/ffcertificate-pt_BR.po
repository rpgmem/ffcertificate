#: includes/settings/views/documentation/config-public-design.php:17
msgid "Public Design"
msgstr "Design Público"

#: includes/settings/tabs/class-ffc-tab-public-design.php:62
msgid "Public Design settings view file not found."
msgstr "Arquivo de visualização das configurações de Design Público não encontrado."

#: includes/settings/views/ffc-tab-public-design.php:18
msgid "Accent (buttons, links and focus)"
msgstr "Destaque (botões, links e foco)"

#: includes/settings/views/ffc-tab-public-design.php:19
msgid "Field borders"
msgstr "Bordas dos campos"

#: includes/settings/views/ffc-tab-public-design.php:20
msgid "Hints and secondary text"
