msgstr "Processamento de submissões (uma por submissão)"

msgid "Reregistration reminder batch (one per batch)"
msgstr "Lote de lembretes do recadastramento (um por lote)"

msgid "Scheduled Tasks"
msgstr "Tarefas Agendadas"

msgid "Running"
msgstr "Em execução"

msgid "Late — has not run when expected"
msgstr "Atrasada — não rodou quando esperado"

