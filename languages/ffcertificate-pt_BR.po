msgstr "Fechar agendamentos antigos (confirmados para concluídos, pendentes para cancelados)"

#: includes/self-scheduling/views/appointments-list.php:464
msgid "Close old appointments now"
msgstr "Fechar agendamentos antigos agora"

#: includes/self-scheduling/class-ffc-self-scheduling-appointment-closeout.php:130
