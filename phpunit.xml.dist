<?xml version="1.0"?>
<phpunit
    bootstrap="tests/bootstrap.php"
    backupGlobals="false"
    colors="true"
    convertErrorsToExceptions="true"
    convertNoticesToExceptions="true"
    convertWarningsToExceptions="true"
    >
    <!--
        THE SUITE'S EXECUTION-TIME BUDGET IS NOT PRODUCT CODE'S TO SET (#1493).

        `Core\BatchedCsvExport::handle_batch()` calls the real
        `set_time_limit( 60 )`, correctly for one HTTP request and disastrously
        for a single process running 8,800 tests: from `BatchedCsvExportTest`
        onwards the rest of the suite shared a budget a test had set on the way
        past. The hook resets it before every test.

        Registered HERE and not called from `tests/bootstrap.php`, which would
        not work: `set_time_limit()` restarts the counter, so the last caller
        wins and bootstrap runs first.
    -->
    <extensions>
        <extension class="FreeFormCertificate\Tests\Support\SuiteCpuBudget"/>
    </extensions>
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory suffix="Test.php">./tests/Integration</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <include>
            <directory suffix=".php">./includes</directory>
        </include>
        <!--
            Markup-only partials included from a renderer's scope. The same
            carve-out `phpstan.neon.dist` makes, and its comment says to keep
            the two lists in step — which they had stopped being: this list
            also named `./includes/libraries` and `./includes/views`, two
            directories that have never existed at any point in the
            repository's history — a `git log` over them, across every ref,
            returns nothing.
            PHPStan dropped them once; this is the other half.

            `includes/self-scheduling/views` is deliberately NOT here: it
            holds real logic, so "a directory named views is markup" is not a
            repo-wide truth.
        -->
        <exclude>
            <directory suffix=".php">./includes/admin/views</directory>
            <directory suffix=".php">./includes/settings/views</directory>
        </exclude>
    </coverage>
</phpunit>
